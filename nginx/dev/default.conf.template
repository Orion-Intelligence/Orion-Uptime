map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;
    set $app_backend ${APP_BACKEND};
    set $hsts "";

    include /etc/nginx/snippets/app-locations.conf;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;
    set $app_backend ${APP_BACKEND};
    set $hsts "";

    ssl_certificate /etc/nginx/local-certs/localhost-cert.pem;
    ssl_certificate_key /etc/nginx/local-certs/localhost-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:5m;
    ssl_session_timeout 10m;

    include /etc/nginx/snippets/app-locations.conf;
}
