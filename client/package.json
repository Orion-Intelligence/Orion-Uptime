{
  "name": "orion-uptime-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve": "ng serve",
    "build": "ng build --configuration=production",
    "build:instrumented": "ng build --configuration=instrumented && node scripts/instrument-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "cypress",
    "lint": "npm run lint:styles && npx eslint src/app --max-warnings=1000",
    "lint:styles": "npx stylelint \"src/**/*.css\"",
    "lint:styles:fix": "npx stylelint \"src/**/*.css\" --fix",
    "lint:fix": "npx stylelint \"src/**/*.css\" --fix ; npx eslint src/app --fix",
    "lint:watch": "npx eslint src/app --watch",
    "cypress": "cypress",
    "cypress:open": "cypress open --e2e",
    "cypress:run": "cypress run --e2e",
    "cypress:run:coverage": "ORION_COVERAGE=true cypress run --e2e"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "json5": "2.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@cypress/code-coverage": "4.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "istanbul-lib-instrument": "6.0.3",
    "lighthouse": "13.4.1",
    "postcss": "^8.5.28",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "nyc": {
    "all": false,
    "include": [
      "src/app/**/*.ts"
    ],
    "exclude": [
      "src/**/*.spec.ts",
      "src/**/*.d.ts"
    ],
    "extension": [
      ".ts"
    ],
    "excludeAfterRemap": true,
    "report-dir": "coverage",
    "reporter": [
      "lcov",
      "json-summary",
      "text-summary"
    ]
  }
}
